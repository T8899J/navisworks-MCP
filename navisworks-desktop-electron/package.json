{
  "name": "navisworks-mcp-desktop-electron",
  "version": "0.2.0-dev.0",
  "private": true,
  "description": "Electron and React desktop client for the Navisworks MCP bridge",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "electron": "41.8.0",
    "electron-vite": "5.0.0",
    "typescript": "~5.8.3",
    "vite": "npm:rolldown-vite@7.3.0",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.19.0"
}
