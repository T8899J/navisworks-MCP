<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>NavisworksMcp.Desktop</RootNamespace>
    <AssemblyName>NavisworksMcpDesktop</AssemblyName>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <Description>Desktop GUI for Navisworks MCP bridge</Description>
  </PropertyGroup>

  <!-- Bridge\*.cs 是本项目自有源码（原先从 navisworks-console 链入，该项目已移除）。
       SDK 默认 glob 会自动包含，无需显式 Compile 项。 -->

</Project>