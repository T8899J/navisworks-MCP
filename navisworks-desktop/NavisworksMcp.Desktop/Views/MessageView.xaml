<UserControl x:Class="NavisworksMcp.Desktop.Views.MessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NavisworksMcp.Desktop.Controls"
             Focusable="False">
    <UserControl.Resources>
        <!-- Message content and message actions are siblings owned by one shell.
             This is the stable boundary for future retry/feedback actions. -->
        <Style TargetType="{x:Type controls:MessageShell}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MessageShell}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter Grid.Row="0"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ContentPresenter x:Name="MessageActions"
                                              Grid.Row="1"
                                              Margin="{TemplateBinding ActionsMargin}"
                                              HorizontalAlignment="{TemplateBinding ActionsHorizontalAlignment}"
                                              Content="{TemplateBinding Actions}"
                                              Opacity="0"
                                              IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MessageActions" Property="Opacity" Value="1" />
                                <Setter TargetName="MessageActions" Property="IsHitTestVisible" Value="True" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MessageActions" Property="Opacity" Value="1" />
                                <Setter TargetName="MessageActions" Property="IsHitTestVisible" Value="True" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyMessageButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTip" Value="{Binding CopyToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.ShowDuration" Value="4000" />
            <Setter Property="AutomationProperties.HelpText" Value="复制当前消息到剪贴板" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Padding="3" Background="{TemplateBinding Background}">
                            <Grid Width="15" Height="15">
                                <Grid x:Name="CopyIcon">
                                    <Viewbox>
                                        <Canvas Width="24" Height="24">
                                            <Rectangle Canvas.Left="8" Canvas.Top="8" Width="14" Height="14"
                                                       RadiusX="2" RadiusY="2"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       StrokeThickness="2" />
                                            <Path Data="M 4 16 C 2.9 16 2 15.1 2 14 L 2 4 C 2 2.9 2.9 2 4 2 L 14 2 C 15.1 2 16 2.9 16 4"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <Path x:Name="CheckIcon"
                                      Data="M 20 6 L 9 17 L 4 12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                <Setter TargetName="CopyIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" Margin="0,0,0,26"
          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ConversationWidthConverter}}">
        <controls:MessageShell HorizontalAlignment="Right"
                               ActionsHorizontalAlignment="Right"
                               ActionsMargin="0,3,4,0">
            <controls:MessageShell.Style>
                <Style TargetType="{x:Type controls:MessageShell}"
                       BasedOn="{StaticResource {x:Type controls:MessageShell}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="user">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:MessageShell.Style>
            <Border HorizontalAlignment="Right" Padding="14,9" CornerRadius="14"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ConversationWidthConverter}, ConverterParameter=user}"
                    Background="{DynamicResource AccentMutedBrush}">
                <TextBlock Text="{Binding Content}" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" LineHeight="23"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <controls:MessageShell.Actions>
                <Button Style="{StaticResource CopyMessageButton}"
                        Click="CopyMessage_Click"
                        AutomationProperties.Name="复制消息" />
            </controls:MessageShell.Actions>
        </controls:MessageShell>

        <controls:MessageShell HorizontalAlignment="Left"
                               ActionsHorizontalAlignment="Left"
                               ActionsMargin="2,3,0,0">
            <controls:MessageShell.Style>
                <Style TargetType="{x:Type controls:MessageShell}"
                       BasedOn="{StaticResource {x:Type controls:MessageShell}}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Role}" Value="user">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:MessageShell.Style>
            <StackPanel HorizontalAlignment="Stretch">
                <Expander Margin="0,0,0,8"
                          IsExpanded="{Binding IsTransient, Mode=OneWay}"
                          Visibility="{Binding HasThinking, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Expander.Style>
                        <Style TargetType="Expander">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Expander">
                                        <StackPanel>
                                            <ToggleButton Cursor="Hand"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" CornerRadius="6" Padding="4,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="深度思考" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                    <Path Width="14" Height="14" Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Data="M 4 3.75 L 10 7 L 4 10.25"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <RotateTransform Angle="90" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                     To="90" Duration="0:0:0.16" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                        <DataTrigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                     To="0" Duration="0:0:0.16" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.ExitActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </StackPanel>
                                            </ToggleButton>
                                            <ContentPresenter x:Name="ExpandSite"
                                                              Visibility="Collapsed"
                                                              Content="{TemplateBinding Content}" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Expander.Style>
                    <TextBlock Text="{Binding ThinkingText}" FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap" LineHeight="23" Margin="14,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Expander>

                <TextBlock Text="{Binding Content}" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap" LineHeight="23">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Role}" Value="system">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="tool">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role}" Value="error">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <controls:MessageShell.Actions>
                <Button Style="{StaticResource CopyMessageButton}"
                        Click="CopyMessage_Click"
                        AutomationProperties.Name="复制回复" />
            </controls:MessageShell.Actions>
        </controls:MessageShell>
    </Grid>
</UserControl>
