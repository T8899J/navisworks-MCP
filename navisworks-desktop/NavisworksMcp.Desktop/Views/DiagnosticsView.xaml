<UserControl x:Class="NavisworksMcp.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border Background="#99000000"
            Visibility="{Binding IsDiagnosticsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
        <Border Width="700" Height="460" CornerRadius="14"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="54" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="运行诊断" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding RuntimeProfileLabel}" Margin="0,4,0,0" FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="32" Height="32" Padding="0" FontSize="18"
                            Style="{StaticResource GhostButton}" Command="{Binding CloseDiagnosticsCommand}"
                            ToolTip="关闭诊断信息" />
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

                <Grid Grid.Row="2" Margin="22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="以下内容来自当前进程实际解析的运行上下文，可用于区分 EXE、构建配置和数据目录。"
                               Margin="0,0,0,12" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Grid.Row="1" Text="{Binding RuntimeDiagnostics, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Padding="14,12" FontFamily="Consolas" FontSize="11"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />
                </Grid>

                <Grid Grid.Row="3" Margin="22,0">
                    <TextBlock Text="提示：自动化测试必须使用 --data-dir 或专用环境变量，不能读取用户会话。"
                               VerticalAlignment="Center" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
