<Window x:Class="NavisworksMcp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Navisworks MCP" Width="1120" Height="720"
        MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Windows-style title bar: sidebar navigation stays left while the
             system caption controls remain anchored to the right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0"
              Background="{DynamicResource SidebarBrush}"
              MouseRightButtonUp="TitleBar_MouseRightButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SidebarToggleButton" Grid.Column="0" Width="40" Height="32" Margin="4,0,0,0" Padding="0"
                    Style="{StaticResource WindowControlButton}" Click="ToggleSidebar_Click"
                    FocusVisualStyle="{x:Null}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="收起边栏  Ctrl+B" AutomationProperties.Name="切换边栏">
                <Grid Width="14" Height="14">
                    <Border CornerRadius="2.5" BorderThickness="1"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Border Width="1" Margin="4.5,0,0,0" HorizontalAlignment="Left"
                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="46" Height="32" Padding="0" Style="{StaticResource WindowControlButton}"
                        Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                    <TextBlock x:Name="MinimizeGlyph" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Text="&#xE921;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="WindowMaximizeButton" Width="46" Height="32" Padding="0"
                        Click="Maximize_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                            <Setter Property="AutomationProperties.Name" Value="最大化" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="AutomationProperties.Name" Value="还原" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="最大化" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Text" Value="还原" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToolTip>
                    </Button.ToolTip>
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- E922 = maximize, E923 = restore -->
                                <Setter Property="Text" Value="&#xE922;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Text" Value="&#xE923;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Width="46" Height="32" Padding="0" Style="{StaticResource WindowCloseButton}"
                        Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Text="&#xE8BB;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

    <Grid Grid.Row="1" Background="{DynamicResource SidebarBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition x:Name="SeparatorColumn" Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The sidebar collapses completely; its toggle remains available in the title bar. -->
        <Border x:Name="SidebarSurface" Grid.Column="0" Width="280" ClipToBounds="True"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Margin="12,10,12,8" Height="40"
                        Style="{StaticResource NewChatButton}" Command="{Binding NewChatCommand}"
                        AutomationProperties.Name="新建对话">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 7,1.5 L 9,1.5 L 9,7 L 14.5,7 L 14.5,9 L 9,9 L 9,14.5 L 7,14.5 L 7,9 L 1.5,9 L 1.5,7 L 7,7 Z"
                                  Fill="{DynamicResource TextPrimaryBrush}" />
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="新对话" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                    <TextBlock Grid.Row="1" Text="最近" Margin="20,3,18,9" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <ListBox Grid.Row="2" ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="0,0,0,10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarItemButton}"
                                        ToolTip="{Binding Preview}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="删除会话"
                                                      Command="{Binding PlacementTarget.Tag.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border MinHeight="36" Padding="20,7" CornerRadius="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding UpdatedLabel}" FontSize="9" Margin="8,1,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="12,8,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Width="34" Height="34" Padding="0" Content="⚙" FontSize="15"
                                Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}"
                                ToolTip="设置" AutomationProperties.Name="设置" />
                        <TextBlock Grid.Column="1" Text="对话记录仅保存在本机" FontSize="10" Margin="8,0,4,0"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <!-- The conversation surface sits above the shared title/sidebar chrome.
             Its rounded top-left corner exposes that chrome for a soft transition. -->
        <Border Grid.Column="2"
                Background="{DynamicResource BackgroundBrush}"
                CornerRadius="14,0,0,0"
                ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Visibility="{Binding HasActiveSession, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentSessionTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1" Padding="10,5" CornerRadius="12"
                            Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NavisworksConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding NavisworksStatus}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="2" Text="•••" FontSize="12" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <ListBox x:Name="ChatBox" ItemsSource="{Binding Messages}"
                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1,1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     PreviewMouseWheel="ChatBox_PreviewMouseWheel"
                     Padding="0,22,0,180">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,26"
                              Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ConversationWidthConverter}}">
                            <!-- User prompts stay compact and right-aligned, matching the Codex conversation rhythm.
                                 Hovering the row reveals a one-click copy button beside the bubble. -->
                            <Grid HorizontalAlignment="Right">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Padding="14,9" CornerRadius="14"
                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ConversationWidthConverter}, ConverterParameter=user}"
                                        Background="{DynamicResource AccentMutedBrush}">
                                    <TextBlock Text="{Binding Content}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="23"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Border>
                                <Button Click="CopyUserMessage_Click" ToolTip="复制"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-32,0,0,-2"
                                        AutomationProperties.Name="复制消息">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="26" Height="22" CornerRadius="5"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                                            <TextBlock Text="⧉" FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="IsHitTestVisible" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Agent, tool and status output remains a borderless document stream on the left. -->
                            <StackPanel HorizontalAlignment="Stretch">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Role}" Value="user">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <!-- Collapsible reasoning chain: expanded while
                                     streaming (IsTransient), collapsed once the
                                     reply lands, still expandable afterwards.
                                     Minimal template: plain-text header with a
                                     bare caret glyph instead of the themed
                                     circle-arrow toggle. -->
                                <Expander Margin="0,0,0,8"
                                          IsExpanded="{Binding IsTransient, Mode=OneWay}"
                                          Visibility="{Binding HasThinking, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Expander.Style>
                                        <Style TargetType="Expander">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Expander">
                                                        <StackPanel>
                                                            <ToggleButton Cursor="Hand"
                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" CornerRadius="6" Padding="4,2">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <ContentPresenter />
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="深度思考" FontSize="12" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                                    <!-- Chevron points right when collapsed,
                                                                         rotates 90° to point down when expanded.
                                                                         Square layout box + centered geometry +
                                                                         origin 0.5,0.5 keep it anchored while
                                                                         rotating; both header children align on
                                                                         the panel's center line. -->
                                                                    <Path Width="14" Height="14"
                                                                          Margin="6,0,0,0"
                                                                          VerticalAlignment="Center"
                                                                          Data="M 4 3.75 L 10 7 L 4 10.25"
                                                                          RenderTransformOrigin="0.5,0.5"
                                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                                          StrokeThickness="2"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round">
                                                                        <Path.Style>
                                                                            <Style TargetType="Path">
                                                                                <Setter Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform Angle="0" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                                                                        <Setter Property="RenderTransform">
                                                                                            <Setter.Value>
                                                                                                <RotateTransform Angle="90" />
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                        <DataTrigger.EnterActions>
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard>
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                                     To="90" Duration="0:0:0.16" />
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </DataTrigger.EnterActions>
                                                                                        <DataTrigger.ExitActions>
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard>
                                                                                                    <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                                                                                     To="0" Duration="0:0:0.16" />
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </DataTrigger.ExitActions>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Path.Style>
                                                                    </Path>
                                                                </StackPanel>
                                                            </ToggleButton>
                                                            <ContentPresenter x:Name="ExpandSite"
                                                                              Visibility="Collapsed"
                                                                              Content="{TemplateBinding Content}" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="True">
                                                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Expander.Style>
                                    <TextBlock Text="{Binding ThinkingText}" FontSize="14" FontWeight="SemiBold"
                                               TextWrapping="Wrap" LineHeight="23" Margin="14,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Expander>

                                <TextBlock Text="{Binding Content}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="23">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="system">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="tool">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="error">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Turn markers live in the reading gutter left of the content, not over the text. -->
            <Grid x:Name="TurnsRail" Panel.ZIndex="3"
                  HorizontalAlignment="Left" VerticalAlignment="Stretch"
                  Margin="{Binding ElementName=ComposerSurface, Path=ActualHeight, Converter={StaticResource GutterMarginConverter}}"
                  Width="{Binding ElementName=ChatBox, Path=ActualWidth, Converter={StaticResource GutterWidthConverter}}">
                <ItemsControl ItemsSource="{Binding ConversationTurns}"
                              HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Opacity" Value="0.35" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1.0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="20" Height="11" Padding="0" Margin="0"
                                    Background="Transparent" BorderThickness="0" Focusable="False"
                                    Cursor="Hand" Click="ConversationTurnMarker_Click"
                                    ToolTipService.InitialShowDelay="120" ToolTipService.BetweenShowDelay="0"
                                    ToolTipService.ShowDuration="60000"
                                    AutomationProperties.Name="{Binding UserPreview, StringFormat=定位到对话：{0}}">
                                <Button.ToolTip>
                                    <ToolTip Placement="Right" HorizontalOffset="8" VerticalOffset="-8"
                                              Background="Transparent" BorderThickness="0" Padding="0"
                                              HasDropShadow="False" OverridesDefaultStyle="True">
                                        <ToolTip.Template>
                                            <ControlTemplate TargetType="{x:Type ToolTip}">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </ToolTip.Template>
                                        <Border Width="300" Padding="12,10" CornerRadius="9"
                                                Background="{DynamicResource ComposerBrush}"
                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="你" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding UserPreview}" FontSize="11" Margin="0,3,0,8"
                                                           TextWrapping="Wrap" MaxHeight="38"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="助手" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding AssistantPreview}" FontSize="10" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" MaxHeight="54"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Marker" Width="11" Height="2" CornerRadius="1"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource TextMutedBrush}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Marker" Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
                                            </Trigger>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Marker"
                                                                         Storyboard.TargetProperty="Width"
                                                                         To="20" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Marker"
                                                                         Storyboard.TargetProperty="Width"
                                                                         To="11" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border x:Name="ComposerSurface" Panel.ZIndex="4" Margin="0,0,0,18"
                    SizeChanged="OnComposerSizeChanged"
                    Width="{Binding ActualWidth, ElementName=ChatBox, Converter={StaticResource ConversationWidthConverter}}"
                    Padding="16,12,10,10" CornerRadius="22"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasActiveSession}" Value="False">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid MinHeight="92">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" FontSize="13" Padding="4,2"
                             MinHeight="44" MaxHeight="112" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_KeyDown" />

                    <TextBlock Grid.Row="0" Text="输入消息，按Enter发送" FontSize="13"
                               Margin="4,2,4,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False" AutomationProperties.Name="输入提示">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Input}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Input}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="1" Width="34" Height="34" Margin="0,0,8,0"
                              VerticalAlignment="Center" Background="Transparent"
                              ToolTipService.InitialShowDelay="220"
                              AutomationProperties.Name="上下文窗口使用量">
                            <Grid.ToolTip>
                                <ToolTip Placement="Top" VerticalOffset="-8"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         HasDropShadow="False" OverridesDefaultStyle="True">
                                    <ToolTip.Template>
                                        <ControlTemplate TargetType="{x:Type ToolTip}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </ToolTip.Template>
                                    <Border Padding="12,10" CornerRadius="8"
                                            Background="{DynamicResource ComposerBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="上下文窗口" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ContextUsagePercentLabel}" Margin="0,5,0,0"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ContextUsageTokensLabel}" Margin="0,3,0,0"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding ContextRemainingLabel}" Margin="0,2,0,0"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Grid.ToolTip>
                            <Ellipse Width="20" Height="20" StrokeThickness="2"
                                     Stroke="{DynamicResource BorderStrongBrush}" />
                            <Ellipse Width="20" Height="20" StrokeThickness="2"
                                     Stroke="{DynamicResource TextSecondaryBrush}"
                                     StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                     StrokeDashArray="{Binding ContextUsagePercent, Converter={StaticResource ContextUsageDashArrayConverter}}"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <Grid Grid.Column="2">
                            <Button x:Name="ModelMenuButton" Height="34" MaxWidth="280"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource ModelSelectorButton}"
                                    Command="{Binding ToggleModelMenuCommand}"
                                    ToolTip="选择模型与推理模式">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LlmModel}" FontSize="11" MaxWidth="165"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="·" FontSize="11" Margin="6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ReasoningLabel}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Viewbox Grid.Column="3" Width="9" Height="9" Margin="8,0,0,0">
                                        <Path Data="M 1,6 L 5,2 L 9,6" Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Viewbox>
                                </Grid>
                            </Button>

                            <Popup x:Name="ModelMenuPopup"
                                   IsOpen="{Binding IsModelMenuOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=ModelMenuButton}"
                                   Placement="Top" VerticalOffset="-8" HorizontalOffset="-28"
                                   StaysOpen="True" AllowsTransparency="True"
                                   PopupAnimation="Fade" Closed="ModelMenuPopup_Closed">
                                <Border x:Name="ModelMenuSurface" Width="260" Padding="8" CornerRadius="12"
                                        Background="{DynamicResource ComposerBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Border x:Name="ModelFlyoutRow" Height="42" Padding="10,0"
                                                CornerRadius="7"
                                                MouseEnter="ModelFlyoutRow_MouseEnter"
                                                MouseLeave="ModelFlyout_MouseLeave">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="模型" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding LlmModel}" Margin="14,0,8,0"
                                                           MaxWidth="135" TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="›" FontSize="15" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </Grid>
                                        </Border>

                                        <Border x:Name="ReasoningFlyoutRow" Height="42" Padding="10,0"
                                                CornerRadius="7"
                                                MouseEnter="ReasoningFlyoutRow_MouseEnter"
                                                MouseLeave="ReasoningFlyout_MouseLeave">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="推理模式" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding ReasoningLabel}" Margin="14,0,8,0"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="›" FontSize="15" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </Grid>
                                        </Border>

                                        <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" />
                                        <Button Content="＋  添加模型" Height="38" Padding="10,0"
                                                Style="{StaticResource ModelMenuItemButton}"
                                                Command="{Binding ShowAddModelCommand}" />
                                        <Grid Margin="6,5,6,3"
                                              Visibility="{Binding IsAddingModel, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="32" Padding="9,6" FontSize="11"
                                                     ToolTip="例如 llama3.2:3b" />
                                            <Button Grid.Column="1" Content="添加" Height="32" Margin="7,0,0,0"
                                                    Style="{StaticResource ComposerPillButton}"
                                                    Command="{Binding AddModelCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Popup x:Name="ModelFlyoutPopup" PlacementTarget="{Binding ElementName=ModelMenuSurface}"
                                   Placement="Left" HorizontalOffset="-8" StaysOpen="True"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="280" Padding="8" CornerRadius="10"
                                        MouseEnter="FlyoutSurface_MouseEnter"
                                        MouseLeave="ModelFlyout_MouseLeave"
                                        Background="{DynamicResource ComposerBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="选择模型" FontSize="10" FontWeight="SemiBold"
                                                   Margin="8,4,8,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AvailableModels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,1" Padding="10,8"
                                                                Command="{Binding DataContext.SelectModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModelMenuItemButton}">
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource ValuesEqualConverter}">
                                                                                    <Binding />
                                                                                    <Binding Path="DataContext.LlmModel"
                                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Grid.Column="1" Text="✓" Margin="10,0,0,0" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                                    <TextBlock.Visibility>
                                                                        <MultiBinding Converter="{StaticResource ValuesEqualConverter}"
                                                                                      ConverterParameter="Visibility">
                                                                            <Binding />
                                                                            <Binding Path="DataContext.LlmModel"
                                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Popup x:Name="ReasoningFlyoutPopup" PlacementTarget="{Binding ElementName=ModelMenuSurface}"
                                   Placement="Left" HorizontalOffset="-8" StaysOpen="True"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="230" Padding="8" CornerRadius="10"
                                        MouseEnter="FlyoutSurface_MouseEnter"
                                        MouseLeave="ReasoningFlyout_MouseLeave"
                                        Background="{DynamicResource ComposerBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="选择推理模式" FontSize="10" FontWeight="SemiBold"
                                                   Margin="8,4,8,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Button Margin="0,1" Padding="10,8"
                                                Command="{Binding SelectReasoningModeCommand}" CommandParameter="fast">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModelMenuItemButton}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFastReasoning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="快速" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="响应优先" FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsFastReasoning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Button>
                                        <Button Margin="0,1" Padding="10,8"
                                                Command="{Binding SelectReasoningModeCommand}" CommandParameter="deep">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModelMenuItemButton}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeepReasoning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="深度" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="质量优先" FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✓" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsDeepReasoning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <Grid Grid.Column="3" Margin="8,0,0,0">
                            <!-- Send morphs into a stop control while a turn is streaming. -->
                            <Button Width="34" Height="34" Padding="0"
                                    Command="{Binding SendCommand}" ToolTip="发送"
                                    AutomationProperties.Name="发送">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SendArrowButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M 8,14 L 8,2 M 3,7 L 8,2 L 13,7"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2.7" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Width="34" Height="34" Padding="0"
                                    Command="{Binding StopGenerationCommand}" ToolTip="停止生成"
                                    AutomationProperties.Name="停止生成">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SendArrowButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Border Width="11" Height="11" CornerRadius="2"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </Grid>
        </Border>

        <!-- Settings center. Model selection shares the same state as the composer. -->
        <Border Grid.ColumnSpan="3" Panel.ZIndex="100"
                Background="#99000000"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="790" Height="560" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="×" Width="32" Height="32" Padding="0" FontSize="18"
                                Style="{StaticResource GhostButton}" Command="{Binding CloseSettingsCommand}"
                                ToolTip="关闭设置" />
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="164" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="12,16">
                            <Button Content="对话" Height="38" Margin="0,0,0,4"
                                    Command="{Binding SelectSettingsPageCommand}" CommandParameter="conversation">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowConversationSettings}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="快捷键" Height="38" Margin="0,0,0,4"
                                    Command="{Binding SelectSettingsPageCommand}" CommandParameter="shortcuts">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowShortcutsSettings}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="模型" Height="38" Margin="0,0,0,4"
                                    Command="{Binding SelectSettingsPageCommand}" CommandParameter="model">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowModelSettings}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="插件" Height="38"
                                    Command="{Binding SelectSettingsPageCommand}" CommandParameter="extensions">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SettingsNavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowExtensionsSettings}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <!-- Conversation settings -->
                        <Grid Grid.Column="2" Margin="28,22"
                              Visibility="{Binding ShowConversationSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="对话" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Text="管理对话记录在本机的保存位置。"
                                       FontSize="11" Margin="0,6,0,18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Grid.Row="2" Text="对话保存位置" FontSize="11" FontWeight="SemiBold"
                                       Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border Grid.Row="3" MinHeight="46" Padding="12,10" CornerRadius="6"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                    ToolTip="{Binding ConversationSavePath, Mode=OneWay}">
                                <TextBlock Text="{Binding ConversationSavePath, Mode=OneWay}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" LineHeight="18" />
                            </Border>
                            <TextBlock Grid.Row="4" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10">
                                <Run Text="会话文件：" />
                                <Run Text="{Binding ConversationSaveFile, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <!-- Keyboard shortcut reference -->
                        <Grid Grid.Column="2" Margin="28,22"
                              Visibility="{Binding ShowShortcutsSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="快捷键" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Text="输入和发送消息时可用的快捷键。"
                                       FontSize="11" Margin="0,6,0,18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <Border Grid.Row="2" Padding="12,11" CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="发送消息" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="立即发送输入框中的内容" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,5" CornerRadius="5"
                                            Background="{DynamicResource ComposerControlBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                        <TextBlock Text="Enter" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Row="3" Padding="12,11" Margin="0,8,0,0" CornerRadius="8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="换行" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="在当前消息中插入新的一行" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,5" CornerRadius="5"
                                            Background="{DynamicResource ComposerControlBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                        <TextBlock Text="Shift + Enter" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Model settings -->
                        <Grid Grid.Column="2" Margin="28,22"
                              Visibility="{Binding ShowModelSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="模型" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Grid.Row="1" Text="管理本地模型、连接状态和推理模式。"
                                       FontSize="11" Margin="0,6,0,18"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <StackPanel Grid.Row="2">
                                <Border Padding="12,11" Margin="0,0,0,18" CornerRadius="8"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,4,10,0"
                                                 VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#737373" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LlmConnected}" Value="True">
                                                            <Setter Property="Fill" Value="#45A77B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding LlmStatus}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding LlmModel}" Margin="0,4,12,0" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="上下文 16K" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text=" · " FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding ReasoningLabel}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="重新连接" Height="32" Padding="12,0"
                                                VerticalAlignment="Center" Style="{StaticResource ComposerPillButton}"
                                                Command="{Binding ConnectLlmCommand}" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="当前模型" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailableModels}"
                                          SelectedItem="{Binding SettingsModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Height="38" Padding="10,5" FontSize="12" />
                                <TextBlock Text="添加模型" FontSize="11" FontWeight="SemiBold" Margin="0,22,0,8"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38" Padding="10,7" ToolTip="例如 qwen3.5:9b-q4_K_M" />
                                    <Button Grid.Column="1" Content="添加" Width="72" Height="38" Margin="8,0,0,0"
                                            Style="{StaticResource AccentButton}" Command="{Binding AddModelCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Extension manager -->
                        <Grid Grid.Column="2" Margin="28,22"
                              Visibility="{Binding ShowExtensionsSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="插件" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,16">
                                <Button Content="插件" Height="32" MinWidth="72" Margin="0,0,6,0"
                                        Command="{Binding SelectExtensionPageCommand}" CommandParameter="plugins">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowPlugins}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="MCP" Height="32" MinWidth="72" Margin="0,0,6,0"
                                        Command="{Binding SelectExtensionPageCommand}" CommandParameter="mcp">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowMcp}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="技能" Height="32" MinWidth="72"
                                        Command="{Binding SelectExtensionPageCommand}" CommandParameter="skills">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SettingsTabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowSkills}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="2" Visibility="{Binding ShowPlugins, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PluginList" ItemsSource="{Binding Plugins}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="本地插件" FontSize="10" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Margin="10,0" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Button Grid.Column="2" Content="移除" Padding="9,4" VerticalAlignment="Center"
                                                                Style="{StaticResource GhostButton}"
                                                                Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="无可用插件" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=PluginList, Path=Items.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewPluginName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38" Padding="10,7" ToolTip="输入插件名称" />
                                    <Button Grid.Column="1" Content="添加插件" Width="88" Height="38" Margin="8,0,0,0"
                                            Style="{StaticResource AccentButton}" Command="{Binding AddPluginCommand}" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Visibility="{Binding ShowMcp, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Border Padding="14,12" CornerRadius="8" VerticalAlignment="Top"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}">
                                            <TextBlock Text="N" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Text="Navisworks MCP" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="内置 MCP · 当前模型与工具调用入口" FontSize="10" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NavisworksConnected}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding NavisworksStatus}" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Visibility="{Binding ShowSkills, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="SkillList" ItemsSource="{Binding Skills}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8"
                                                        Background="{DynamicResource SurfaceBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="本地技能" FontSize="10" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="1" Content="启用" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Margin="10,0" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <Button Grid.Column="2" Content="移除" Padding="9,4" VerticalAlignment="Center"
                                                                Style="{StaticResource GhostButton}"
                                                                Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="无可用技能" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=SkillList, Path=Items.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSkillName, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38" Padding="10,7" ToolTip="输入技能名称" />
                                    <Button Grid.Column="1" Content="添加技能" Width="88" Height="38" Margin="8,0,0,0"
                                            Style="{StaticResource AccentButton}" Command="{Binding AddSkillCommand}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
    </Grid>
</Window>
